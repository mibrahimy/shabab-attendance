{
  "name": "attendance-app-mvp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "eslint",
    "test": "vitest run",
    "format": "prettier --write .",
    "seed": "npx tsx --tsconfig tsconfig.json prisma/seed.ts",
    "seed:v2": "npx tsx --tsconfig tsconfig.json prisma/v2/seed.ts",
    "prisma:v2:generate": "prisma generate --schema prisma/v2/schema.prisma",
    "prisma:v2:migrate": "prisma migrate dev --schema prisma/v2/schema.prisma",
    "postinstall": "prisma generate && prisma generate --schema prisma/v2/schema.prisma"
  },
  "prisma": {
    "seed": "npx tsx --tsconfig tsconfig.json prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.1.3",
    "next": "16.1.6",
    "prisma": "^6.19.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prettier": "^3.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
